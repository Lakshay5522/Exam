# ---------------- provider (pick ONE) ----------------
# Default: Google Gemini. Works everywhere, includes web-search grounding.
#
# MULTIPLE FREE KEYS (no investment needed): every Google account can
# create its own free key at https://aistudio.google.com/apikey — list
# them comma-separated and the server round-robins requests across them,
# switching instantly to the next key on any quota (429) error:
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=your-first-gemini-api-key

# Alternative: any OpenAI-compatible provider (Groq, OpenRouter, Cerebras,
# Together, local Ollama...). OPENAI_API_KEY also accepts a comma list.
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-provider-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# THIRD-PARTY GATEWAYS (e.g. codecraftapi.com, tokenbargain.dev) — add any
# number; they rotate TOGETHER with your Gemini keys, and a quota error on
# one instantly switches to the next. One entry per site:
#   name|base_url|api_key|model    (entries separated by ;)
# Copy the base URL + a model name from each site's dashboard/docs.
# Example:
# COMPAT_ENDPOINTS=codecraft|https://codecraftapi.com/v1|cc-your-key|their-model-name;tokenbargain|https://tokenbargain.dev/v1|tb-your-key|their-model-name
COMPAT_ENDPOINTS=

# ---------------- options ----------------
# Optional: require this code from users (X-Access-Code header or ?code=)
ACCESS_CODE=
# Optional: override the Gemini model (auto-falls back if unavailable)
GEMINI_MODEL=gemini-3.6-flash
# Optional: lighter model to try when the primary is overloaded
GEMINI_FALLBACK_MODEL=
# Google-Search grounding for current-affairs questions (1 = on)
WEB_SEARCH=1
